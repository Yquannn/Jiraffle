# Root backend environment
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me

ADS_DB_NAME=jiraffle_ads
ANALYTICS_DB_NAME=jiraffle_analytics
AUTH_DB_NAME=jiraffle_auth
TASK_DB_NAME=jiraffle_tasks

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=86400000

# Optional: point services to a different env file instead of the repo root .env
# JIRAFFE_ENV_FILE=/absolute/path/to/.env
